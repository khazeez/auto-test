{
  "name": "lawang-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "newman": "node --no-deprecation ./Newman/run-test.js",
    "k6": "node --no-deprecation ./k6-test/run-test.js",
    "test:dev": "node --no-deprecation ./node_modules/.bin/newman run ./Newman/collections/\"Test API Lawang.postman_collection.json\" -e ./Newman/env/Lawang-Core.postman_environment.json --working-dir ./Newman --insecure",
    "test:local": "node --no-deprecation ./node_modules/.bin/newman run ./Newman/collections/\"Test API Lawang.postman_collection.json\" -e ./Newman/env/Local.postman_environment.json --working-dir ./Newman --insecure"
  },
  "devDependencies": {
    "axios": "^1.13.6",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "k6": "^0.0.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "knex": "^3.1.0",
    "pg": "^8.20.0"
  }
}